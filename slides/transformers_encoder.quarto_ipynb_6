    "\n",
    "## NLP Example: Sentiment Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "5e857c31",
   "metadata": {},
   "outputs": [],
   "source": [
    "inputs = tf.keras.Input(shape=(None,))\n",
    "x = layers.Embedding(10000, 128)(inputs)\n",
    "\n",
    "x = EncoderStack(2, 128, 4, 256)(x)\n",
    "x = layers.GlobalAveragePooling1D()(x)\n",
    "\n",
    "outputs = layers.Dense(2, activation='softmax')(x)\n",
    "model = tf.keras.Model(inputs, outputs)"
