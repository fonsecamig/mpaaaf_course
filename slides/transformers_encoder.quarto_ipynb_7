        "---\n",
        "\n",
        "## Stacking Encoders"
      ],
      "id": "5f3f83e9"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "class EncoderStack(tf.keras.layers.Layer):\n",
        "    def __init__(self, num_layers, d_model, num_heads, dff):\n",
        "        super().__init__()\n",
        "        self.layers_ = [\n",
        "            TransformerEncoder(d_model, num_heads, dff)\n",
        "            for _ in range(num_layers)\n",
        "        ]\n",
        "\n",
        "    def call(self, x):\n",
        "        for layer in self.layers_:\n",
        "            x = layer(x)\n",
        "        return x"
      ],
      "id": "9829606f",
      "execution_count": null,
      "outputs": []
    },
